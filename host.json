{
  "version": 1,
  "hostKind": "feltos.enterprise-host",
  "instance": "../../sites/ops.bindinggenerations.net/config/metroplat-instance.json",
  "web": {
    "cookiePrefix": "ops",
    "instructions": "Binding Generations operations.",
    "capabilities": [
      "agent-work-dispatch",
      "work-item",
      "milestone",
      "ledger-readings",
      "ledger-report"
    ],
    "networkSources": [],
    "companions": [
      {
        "module": "@lenticule-science/l-space/site",
        "export": "lSpaceApplication",
        "environmentFileKey": "OPS_LSPACE_ENVIRONMENT_FILE",
        "port": 18848
      }
    ],
    "environmentAliases": {
      "METROPLAT_WEB_STATE_DIR": "OPS_STATE_DIR",
      "METROPLAT_REPOSITORY_ROOT": "OPS_REPOSITORY_ROOT",
      "METROPLAT_ALLOWED_EMAIL": "OPS_ALLOWED_EMAIL",
      "METROPLAT_WEB_DATA_DIR": "OPS_DATA_DIR",
      "METROPLAT_MCP_SUBJECT": "OPS_METROPLAT_SUBJECT",
      "METROPLAT_MCP_CAPABILITIES": "OPS_METROPLAT_CAPABILITIES",
      "METROPLAT_LSPACE_GATEWAY_TOKEN": "OPS_LSPACE_GATEWAY_TOKEN",
      "METROPLAT_LSPACE_MCP_URL": "OPS_LSPACE_MCP_URL",
      "METROPLAT_MCP_UPSTREAMS": "OPS_MCP_UPSTREAMS",
      "METROPLAT_MCP_INSTRUCTIONS": "OPS_MCP_INSTRUCTIONS"
    }
  }
}
